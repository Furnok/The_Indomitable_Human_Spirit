      m_Calls: []
  m_text: '<style="TitleTuto">ATTACK</style>


    To attack you need to <style="W1">hold</style>
    the {ATTACK} button and press consecutively {ATTACK_UPGRADE} to reach a step
    bar <style="W1">marked </style> on the conviction bar with a <style="W1">black
    bar</style> and on release  {ATTACK} will consume your entire  <style="Conviction">conviction
    bar </style> highlighted on the bottom of the screen, each reached step will
    <style="W1">multiply the damage </style>of your attack.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 30b824733b613a546a2e5ec327a7aee6, type: 2}
