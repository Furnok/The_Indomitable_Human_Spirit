--- !u!114 &6301504330522443187
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6708106787068071349}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 69beb381e244f92449b8c4cf954630e9, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_TrackedObjects:
  - rid: 1159296779615993856
  references:
    version: 2
    RefIds:
    - rid: 1159296779615993856
      type: {class: TrackedUGuiGraphic, ns: UnityEngine.Localization.PropertyVariants.TrackedObjects, asm: Unity.Localization}
      data:
        m_Target: {fileID: 8783746312591220749}
        m_TrackedProperties:
          items:
          - rid: 1159296779615993857
        m_UpdateType: 0
    - rid: 1159296779615993857
      type: {class: StringTrackedProperty, ns: UnityEngine.Localization.PropertyVariants.TrackedProperties, asm: Unity.Localization}
      data:
        m_PropertyPath: m_text
        m_VariantData:
        - localeIdentifier:
            m_Code: en
          value: '<style="TitleTuto">CONVICTION</style>


            You have a
            resource bar on the bottom of your screen who is your <style="Conviction">conviction</style>
            that''s can be <style="W1">gain</style> with <color="Yellow">parry </color>and
            <style="W1">dodge</style> perfectly attacks, and you will use it to perform
            <style="W1">charging attack</style> and to <color="Green">heal </color>yourself
            if you have enough <style="Conviction">conviction</style>.


            Press
            {NEXT} to continue'
        - localeIdentifier:
            m_Code: fr
          value: "<style=\"TitleTuto\">CONVICTION</style>\n\nVous disposez d'une
            barre de ressources en bas de votre \xE9cran, repr\xE9sentant votre <style=\"Conviction\">conviction</style>.
            Celle-ci se gagne en <color=\"Yellow\">parant</color> et en <color=\"Red\">esquivant</color>
            parfaitement les attaques. Vous l'utiliserez pour effectuer une <style=\"W1\">attaque
            charg\xE9e</style> et pour vous <color=\"Green\">soigner</color> si vous
            en avez suffisamment.\n\nAppuies sur {NEXT} pour continuer"
